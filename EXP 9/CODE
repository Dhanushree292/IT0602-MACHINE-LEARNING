# Compare Linear and Polynomial Regression

from sklearn.linear_model import LinearRegression

from sklearn.preprocessing import PolynomialFeatures

from sklearn.pipeline import make_pipeline

 

X = [[1], [2], [3], [4], [5]]

y = [2, 4, 9, 16, 25]

 

linear = LinearRegression()

linear.fit(X, y)

 

poly = make_pipeline(PolynomialFeatures(degree=2), LinearRegression())

poly.fit(X, y)

 

sample = [[6]]

print("Dataset X:", X)

print("Dataset y:", y)

print("Linear Regression prediction:", round(linear.predict(sample)[0], 2))

print("Polynomial Regression prediction:", round(poly.predict(sample)[0], 2))

print("Linear R2 Score:", round(linear.score(X, y), 3))

print("Polynomial R2 Score:", round(poly.score(X, y), 3))

